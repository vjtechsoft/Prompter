# Environment variables template for Prompter
# Database connection string (MySQL)
DATABASE_URL="mysql://root:@localhost:3306/prompter"

# JWT Secret for session authentication (change in production!)
JWT_SECRET="super-secret-jwt-key-for-prompt-management-app-2026-production-ready"

# Public application base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Hostinger / Shared Hosting Thread & Resource Limits (Prevents OS error 11)
TOKIO_WORKER_THREADS=1
UV_THREADPOOL_SIZE=1
NEXT_CPU_NUM=1
