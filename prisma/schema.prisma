datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  password         String
  role             String        @default("ADMIN") // "SUPER_ADMIN" or "ADMIN"
  avatar           String?       @db.Text
  status           String        @default("ACTIVE") // "ACTIVE" or "INACTIVE"
  rememberToken    String?       @db.Text
  resetToken       String?       @db.Text
  resetTokenExpiry DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  prompts          Prompt[]
  categories       Category[]
  activityLogs     ActivityLog[]
  loginLogs        LoginLog[]
  notifications    Notification[]
  subcategories    Subcategory[]
}

model Category {
  id            String        @id @default(cuid())
  title         String        @unique
  slug          String        @unique
  image         String        @db.Text
  status        Boolean       @default(true)
  isFeatured    Boolean       @default(false)
  position      Int           @default(0)
  createdById   String
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  prompts       Prompt[]
  subcategories Subcategory[]

  @@index([isFeatured])
}

model Subcategory {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  image       String?  @db.Text
  status      Boolean  @default(true)
  position    Int      @default(0)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prompts     Prompt[]

  @@unique([categoryId, title])
  @@index([categoryId])
  @@index([createdById])
}

model Prompt {
  id               String           @id @default(cuid())
  title            String           @unique
  slug             String           @unique
  prompt           String           @db.Text
  featuredImage    String           @db.Text
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId    String?
  subcategory      Subcategory?     @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  tags             String           @default("[]") @db.Text
  likes            Int              @default(0)
  views            Int              @default(0)
  shares           Int              @default(0)
  copies           Int              @default(0)
  isPremium        Boolean          @default(false)
  isFeatured       Boolean          @default(false)
  status           Boolean          @default(true)
  isDeleted        Boolean          @default(false)
  createdById      String
  createdBy        User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  promptLikes      PromptLike[]
  promptActivities PromptActivity[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([subcategoryId])
  @@index([isFeatured])
}

model Advertisement {
  id                         String   @id @default("default")
  activeProvider             String   @default("ADMOB")
  interstitialInterval       Int      @default(3)
  nativeInterval             Int      @default(5)
  admobEnabled               Boolean  @default(true)
  admobAppId                 String   @default("")
  admobBannerId              String   @default("")
  admobInterstitialId        String   @default("")
  admobRewardedId            String   @default("")
  admobNativeId              String   @default("")
  admobAppOpenId             String   @default("")
  metaEnabled                Boolean  @default(false)
  metaBannerId               String   @default("")
  metaInterstitialId         String   @default("")
  metaRewardedId             String   @default("")
  metaNativeId               String   @default("")
  unityEnabled               Boolean  @default(false)
  unityGameId                String   @default("")
  unityBannerPlacement       String   @default("")
  unityInterstitialPlacement String   @default("")
  unityRewardedPlacement     String   @default("")
  updatedAt                  DateTime @updatedAt
}

model NotificationSetting {
  id               String   @id @default("default")
  provider         String   @default("FCM")
  fcmProjectId     String   @default("")
  fcmClientEmail   String   @default("")
  fcmPrivateKey    String   @default("") @db.Text
  fcmServerKey     String   @default("") @db.Text
  fcmTopic         String   @default("all_users")
  oneSignalAppId   String   @default("")
  oneSignalRestKey String   @default("")
  isEnabled        Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model Notification {
  id           String    @id @default(cuid())
  title        String
  message      String    @db.Text
  image        String?   @db.Text
  deepLink     String?   @db.Text
  targetTopic  String?   @default("all_users")
  sendToAll    Boolean   @default(true)
  scheduledAt  DateTime?
  sentAt       DateTime?
  status       String    @default("SENT")
  successCount Int       @default(0)
  failureCount Int       @default(0)
  errorMessage String?   @db.Text
  createdById  String
  createdBy    User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, scheduledAt])
}

model FcmDeviceToken {
  id         String   @id @default(cuid())
  token      String   @unique
  deviceId   String?
  userId     String?
  platform   String?
  appVersion String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([token])
  @@index([deviceId])
  @@index([userId])
  @@index([platform])
}

model AppSettings {
  id              String   @id @default("default")
  appName         String   @default("Prompter Admin")
  developerName   String   @default("Prompter Devs")
  packageName     String   @default("com.codemario.prompter")
  versionName     String   @default("1.0.0")
  versionCode     String   @default("100")
  supportEmail    String   @default("support@prompter.io")
  website         String   @default("https://prompter.io")
  contactNumber   String   @default("+1 (555) 019-2834")
  copyright       String   @default("© 2026 Prompter. All rights reserved.")
  defaultLanguage String   @default("en")
  theme           String   @default("system")
  timezone        String   @default("UTC")
  currency        String   @default("USD ($)")
  maintenanceMode Boolean  @default(false)
  clientApiKey    String   @default("prompter_live_sec_7f8a9b1c2d3e4f5a")
  requireApiKey   Boolean  @default(true)
  appLogo         String   @default("/logo.png") @db.Text
  splashLogo      String   @default("/logo.png") @db.Text
  appIcon         String   @default("/icon.png") @db.Text
  favicon         String   @default("/favicon.ico") @db.Text
  updatedAt       DateTime @updatedAt
}

model AppUrls {
  id                 String   @id @default("default")
  privacyPolicy      String   @default("https://prompter.io/privacy") @db.Text
  termsOfService     String   @default("https://prompter.io/terms") @db.Text
  refundPolicy       String   @default("https://prompter.io/refund") @db.Text
  dataDeletionPolicy String   @default("https://prompter.io/data-deletion") @db.Text
  contactUs          String   @default("https://prompter.io/contact") @db.Text
  aboutUs            String   @default("https://prompter.io/about") @db.Text
  website            String   @default("https://prompter.io") @db.Text
  playStore          String   @default("https://play.google.com/store/apps/details?id=com.codemario.prompter") @db.Text
  facebook           String   @default("https://facebook.com/prompter") @db.Text
  instagram          String   @default("https://instagram.com/prompter") @db.Text
  youtube            String   @default("https://youtube.com/@prompter") @db.Text
  twitter            String   @default("https://x.com/prompter") @db.Text
  telegram           String   @default("https://t.me/prompter") @db.Text
  updatedAt          DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  details   String?  @db.Text
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?  @db.Text
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())
}

model AppUser {
  id           String   @id @default(cuid())
  name         String   @default("User")
  email        String   @unique
  avatar       String?  @db.Text
  authProvider String   @default("GOOGLE")
  status       String   @default("ACTIVE")
  isVip        Boolean  @default(false)
  appVersion   String?
  likesCount   Int      @default(0)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PromptLike {
  id               String   @id @default(cuid())
  promptId         String
  prompt           Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  clientIdentifier String
  userId           String?
  createdAt        DateTime @default(now())

  @@unique([promptId, clientIdentifier])
  @@index([promptId])
  @@index([clientIdentifier])
  @@index([userId])
}

model PromptActivity {
  id               String   @id @default(cuid())
  promptId         String
  prompt           Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  type             String
  clientIdentifier String?
  createdAt        DateTime @default(now())

  @@index([promptId, type, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@index([promptId, createdAt])
}

model TrendingSetting {
  id                    String   @id @default("default")
  weightViews           Float    @default(1.0)
  weightLikes           Float    @default(3.0)
  weightCopies          Float    @default(5.0)
  weightShares          Float    @default(4.0)
  maxPromptsPerCategory Int      @default(10)
  enableToday           Boolean  @default(true)
  enableWeekly          Boolean  @default(true)
  enableMonthly         Boolean  @default(true)
  enableAllTime         Boolean  @default(true)
  minScoreThreshold     Float    @default(0.0)
  updatedAt             DateTime @updatedAt
}

model UploadedFile {
  id        String   @id @default(cuid())
  filename  String   @unique
  mimeType  String
  data      String   @db.LongText
  size      Int
  createdAt DateTime @default(now())

  @@index([filename])
}
